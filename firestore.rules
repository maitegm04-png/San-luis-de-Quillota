rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate document IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // Players collection
    match /players/{playerId} {
      allow read, write: if isValidId(playerId);
    }

    // Match sheets collection
    match /matches/{matchId} {
      allow read, write: if isValidId(matchId);
    }

    // Club configuration
    match /club/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Staff per category
    match /staff/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Weekly planning collection
    match /weekly_plans/{planId} {
      allow read, write: if isValidId(planId);
    }

    // Medical injuries collection
    match /injuries/{injuryId} {
      allow read, write: if isValidId(injuryId);
    }

    // Citations / Convocatorias collection
    match /citations/{citationId} {
      allow read, write: if isValidId(citationId);
    }

    // Daily wellness check-ins
    match /checkins/{checkinId} {
      allow read, write: if isValidId(checkinId);
    }

    // Daily post-session check-outs
    match /checkouts/{checkoutId} {
      allow read, write: if isValidId(checkoutId);
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }
  }
}
